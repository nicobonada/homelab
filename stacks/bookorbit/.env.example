# Key names for 1Password Environment Homelab (deploy materializes .env).
# Never commit plaintext values.

# BookOrbit application
TZ=America/Argentina/Mendoza
# Host publish port; default matches stacks/caddy/.env.example
BOOKORBIT_PORT=6060

# PostgreSQL container (pgvector/pgvector:pg18; user/db fixed as bookorbit)
POSTGRES_PASSWORD=

# App secrets (openssl rand -hex 32 for each)
JWT_SECRET=
PODCAST_ENCRYPTION_KEY=
SETUP_BOOTSTRAP_TOKEN=
