# Optional local notes / tooling — not required by compose.yaml.
# Copy to kuma-admin.env (gitignored; stacks/**/*-admin.env).
#
# Uptime Kuma 1.x API keys (Settings → API Keys) authenticate Prometheus
# /metrics via HTTP Basic Auth: username empty, password = the key.
# They do NOT cover Socket.IO admin (add/edit monitors); that still needs
# username/password (or UI / careful DB ops).
KUMA_URL=http://127.0.0.1:3001
KUMA_API_KEY=
KUMA_USER=
KUMA_PASS=
