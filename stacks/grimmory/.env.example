# Key names for 1Password Environment Homelab (deploy materializes .env).
# Never commit plaintext values.

# Grimmory application
APP_USER_ID=1000
APP_GROUP_ID=1000
TZ=America/Argentina/Mendoza
BOOKLORE_PORT=6060

# Database (Grimmory app)
DATABASE_URL=jdbc:mariadb://mariadb:3306/grimmory
DB_USER=grimmory
DB_PASSWORD=

# MariaDB container
DB_USER_ID=1000
DB_GROUP_ID=1000
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=grimmory
