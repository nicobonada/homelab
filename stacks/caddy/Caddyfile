# Tailnet HTTPS with Caddy's local CA (not Let's Encrypt, not WAN).
# Trust the CA once on each seat (see README) or the browser will warn.
#
# How a name works: Technitium A → this host (CADDY_BIND). Browser hits :443
# with Host: foo.lab.bonada.ca. Caddy matches @foo and reverse_proxies to the
# real listener. A records that point at another machine never reach Caddy.

{
	local_certs
	# Wildcard listen so Homepage (monitoring_default) can scrape the admin
	# API. Not published on the host or tailnet. Loopback still works for reload.
	admin :2019
}

dashboard.lab.bonada.ca, status.lab.bonada.ca, docs.lab.bonada.ca, books.lab.bonada.ca, dns.lab.bonada.ca, sync.lab.bonada.ca, pve.lab.bonada.ca {
	tracing {
		span caddy
	}

	@dashboard host dashboard.lab.bonada.ca
	handle @dashboard {
		reverse_proxy host.docker.internal:3000
	}

	@status host status.lab.bonada.ca
	handle @status {
		reverse_proxy host.docker.internal:3001
	}

	@docs host docs.lab.bonada.ca
	handle @docs {
		reverse_proxy host.docker.internal:1221
	}

	@books host books.lab.bonada.ca
	handle @books {
		reverse_proxy host.docker.internal:{$BOOKLORE_PORT:6060}
	}

	@dns host dns.lab.bonada.ca
	handle @dns {
		reverse_proxy host.docker.internal:5380
	}

	@sync host sync.lab.bonada.ca
	handle @sync {
		reverse_proxy host.docker.internal:8384
	}

	# Hypervisor is not on this VM. Upstream URL stays in Homelab env (private).
	# PVE's UI returns 501 for HEAD; Homepage siteMonitor uses HEAD through Caddy.
	@pve_head {
		host pve.lab.bonada.ca
		method HEAD
	}
	handle @pve_head {
		reverse_proxy {$PVE_UPSTREAM} {
			method GET
			transport http {
				tls
				tls_insecure_skip_verify
			}
		}
	}

	@pve host pve.lab.bonada.ca
	handle @pve {
		reverse_proxy {$PVE_UPSTREAM} {
			transport http {
				tls
				tls_insecure_skip_verify
			}
		}
	}

	handle {
		respond "caddy: unknown host" 404
	}
}
