# 1Password Environment Homelab → deploy-containers writes .env (never commit).

# Honeycomb *ingest* key (not Configuration). Concealed in 1P.
HONEYCOMB_API_KEY=

# Lab Tailscale IPv4 only (tailscale ip -4 on the lab). Not a LAN/WAN address.
CADDY_BIND=

# Grimmory publish port; default matches stacks/grimmory/.env.example
BOOKLORE_PORT=6060
