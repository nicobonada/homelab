# Shape only — real values are created by scripts/openbao-bootstrap into
# sops-encrypted secrets/openbao.env (never commit plaintext).
#
# sops for unseal + root only. App secrets live in OpenBao KV (secret/stacks/*).

# Unseal key (Shamir; this lab uses 1 share / threshold 1)
UNSEAL_KEY=

# Initial root token (rotate / create admin tokens after bootstrap if desired)
ROOT_TOKEN=

# Optional override for scripts (default: http://127.0.0.1:8200 via docker exec)
# BAO_ADDR=http://127.0.0.1:8200
