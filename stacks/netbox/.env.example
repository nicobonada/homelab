# Key names for 1Password Environment "Homelab" (deploy materializes .env).
# Prefix NETBOX_ so these do not collide with grimmory DB_* keys.
# Never commit plaintext values. SECRET_KEY and API_TOKEN_PEPPER must be ≥50 characters.

NETBOX_SECRET_KEY=
NETBOX_API_TOKEN_PEPPER=
NETBOX_DB_PASSWORD=
NETBOX_REDIS_PASSWORD=
NETBOX_REDIS_CACHE_PASSWORD=
NETBOX_SUPERUSER_NAME=nico
NETBOX_SUPERUSER_EMAIL=
NETBOX_SUPERUSER_PASSWORD=
