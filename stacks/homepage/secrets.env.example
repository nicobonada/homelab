# Key names for 1Password Environment "Homelab" (deploy materializes secrets.env).
# Never commit plaintext values.
#
# Hrefs and probe URLs live in config/*.yaml. Only API tokens stay here.

# Proxmox: Datacenter → Permissions → API Tokens + ACL (PVEAuditor on /)
# username format: user@realm!tokenid  (prefer @pve, e.g. homepage@pve!homelab-dashboard)
HOMEPAGE_VAR_PVE_TOKEN=
HOMEPAGE_VAR_PVE_SECRET=
# Technitium: user menu → Create API Token (prefer dedicated user e.g. homepage)
HOMEPAGE_VAR_TECHNITIUM_KEY=
# Syncthing: Actions → Settings → General → API Key (hub on the lab)
HOMEPAGE_VAR_SYNCTHING_KEY=
# Tailscale: https://login.tailscale.com/admin/settings/keys (access token, max 90d)
# Device ID: Machines → homelab → Machine Details → ID (…CNTRL)
HOMEPAGE_VAR_TAILSCALE_KEY=
HOMEPAGE_VAR_TAILSCALE_DEVICE_ID=
