# Key names for 1Password Environment "Homelab" (deploy materializes secrets.env).
# Never commit plaintext values.

# Required for non-localhost access (comma-separated hosts, no spaces).
# Include lab Tailscale IP:3000 and any MagicDNS names you use for the UI.
# Include dashboard.lab.bonada.ca (and/or *.lab.bonada.ca) when using Caddy.
HOMEPAGE_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000,homelab:3000,dashboard.lab.bonada.ca,*.lab.bonada.ca

# Service URLs used in config/*.yaml via {{HOMEPAGE_VAR_*}}
# Browser hrefs for lab apps are hardcoded lab.bonada.ca in services.yaml.
# These vars remain for PVE (Serve) and widget/probe URLs.
HOMEPAGE_VAR_PVE_URL=
HOMEPAGE_VAR_DNS_URL=
# From the Homepage container: host.docker.internal:5380 (compose extra_hosts).
# href stays HOMEPAGE_VAR_DNS_URL (browser / MagicDNS).
HOMEPAGE_VAR_TECHNITIUM_HTTP=http://host.docker.internal:5380
# From the Homepage container: host.docker.internal:8384 (compose extra_hosts).
# href is https://sync.lab.bonada.ca (Caddy). Do not open tailnet :8384.
HOMEPAGE_VAR_SYNCTHING_HTTP=http://host.docker.internal:8384
HOMEPAGE_VAR_GATUS_HTTP=
HOMEPAGE_VAR_GRIMMORY_HTTP=
HOMEPAGE_VAR_PAPRA_HTTP=
HOMEPAGE_VAR_NETBOX_HTTP=http://host.docker.internal:8000
# Same-container loopback + official health endpoint. Do not use the public
# HTTPS dashboard URL (Serve VIP often fails from the lab origin) or the
# dashboard HTML path (self-monitor of / can 500).
HOMEPAGE_VAR_HOMEPAGE_HTTP=http://127.0.0.1:3000/api/healthcheck
HOMEPAGE_VAR_GLANCES_HTTP=

# Optional widgets — set in 1P Homelab, enable matching widget in services.yaml
# Proxmox: Datacenter → Permissions → API Tokens + ACL (PVEAuditor on /)
# username format: user@realm!tokenid  (prefer @pve, e.g. homepage@pve!homelab-dashboard)
HOMEPAGE_VAR_PVE_TOKEN=
HOMEPAGE_VAR_PVE_SECRET=
# Technitium: user menu → Create API Token (prefer dedicated user e.g. homepage)
HOMEPAGE_VAR_TECHNITIUM_KEY=
# Syncthing: Actions → Settings → General → API Key (hub on the lab)
HOMEPAGE_VAR_SYNCTHING_KEY=
# Tailscale: https://login.tailscale.com/admin/settings/keys (access token, max 90d)
# Device ID: Machines → homelab → Machine Details → ID (…CNTRL)
HOMEPAGE_VAR_TAILSCALE_KEY=
HOMEPAGE_VAR_TAILSCALE_DEVICE_ID=
