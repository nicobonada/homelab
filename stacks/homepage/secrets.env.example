# Copy shape only — real values live in sops-encrypted secrets/homepage.env
# (decrypted to secrets.env by scripts/deploy-containers). Never commit plaintext.

# Required for non-localhost access (comma-separated hosts, no spaces).
# Include lab Tailscale IP:3000 and any MagicDNS names you use for the UI.
HOMEPAGE_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000,homelab:3000

# Service URLs used in config/*.yaml via {{HOMEPAGE_VAR_*}}
# Prefer full URLs so the public yaml has no tailnet/IP literals.
HOMEPAGE_VAR_PVE_URL=
HOMEPAGE_VAR_DNS_URL=
HOMEPAGE_VAR_STATUS_URL=
HOMEPAGE_VAR_BOOKS_URL=
HOMEPAGE_VAR_DOCS_URL=
HOMEPAGE_VAR_DASHBOARD_URL=
HOMEPAGE_VAR_TECHNITIUM_HTTP=
HOMEPAGE_VAR_KUMA_HTTP=
HOMEPAGE_VAR_GRIMMORY_HTTP=
HOMEPAGE_VAR_PAPRA_HTTP=
HOMEPAGE_VAR_HOMEPAGE_HTTP=
HOMEPAGE_VAR_GLANCES_HTTP=

# Optional widgets (uncomment matching blocks in config/services.yaml)
# Proxmox: Datacenter → Permissions → API Tokens (PVEAuditor)
# username format: user@pam!tokenid
HOMEPAGE_VAR_PVE_TOKEN=
HOMEPAGE_VAR_PVE_SECRET=
# Technitium: Admin → Administration → API Keys (API-only user)
HOMEPAGE_VAR_TECHNITIUM_KEY=
# Tailscale: https://login.tailscale.com/admin/settings/keys
HOMEPAGE_VAR_TAILSCALE_KEY=
HOMEPAGE_VAR_TAILSCALE_DEVICE_ID=
