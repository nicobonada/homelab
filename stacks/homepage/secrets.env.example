# Copy to secrets.env and fill in (gitignored).
# After editing: ./scripts/stack-up homepage

# Proxmox: Datacenter → Permissions → API Tokens (PVEAuditor)
# username format: user@pam!tokenid
HOMEPAGE_VAR_PVE_TOKEN=
HOMEPAGE_VAR_PVE_SECRET=

# Technitium: Admin → Administration → API Keys (API-only user)
HOMEPAGE_VAR_TECHNITIUM_KEY=

# Tailscale: https://login.tailscale.com/admin/settings/keys
HOMEPAGE_VAR_TAILSCALE_KEY=
