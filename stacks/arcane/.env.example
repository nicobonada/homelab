# Copy to .env on the host (never commit .env)
APP_URL=https://docker.<tailnet>.ts.net
PUID=1000
PGID=1000
ENCRYPTION_KEY=
JWT_SECRET=
LOG_LEVEL=info
LOG_JSON=false
OIDC_ENABLED=false
# SQLite inside the data volume (default Arcane layout)
DATABASE_URL=file:data/arcane.db?_pragma=journal_mode(WAL)&_pragma=busy_timeout(2500)&_txlock=immediate
