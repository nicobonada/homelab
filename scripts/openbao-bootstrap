#!/usr/bin/env bash
# First-time OpenBao init + KV layout. Writes unseal key + root token to sops only.
# Does not change app env deploy (homepage/grimmory/papra still use secrets/*.env).
#
# Usage:
#   ./scripts/deploy-containers openbao
#   ./scripts/openbao-bootstrap
#   ./scripts/openbao-bootstrap --seed-from-sops
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STACK="$ROOT/stacks/openbao"
ENC="$ROOT/secrets/openbao.env"
SECRETS="$ROOT/secrets"
export DOCKER_HOST="${DOCKER_HOST:-ssh://nico@homelab}"

SEED=0
for arg in "$@"; do
  case $arg in
    --seed-from-sops) SEED=1 ;;
    -h | --help)
      echo "usage: $0 [--seed-from-sops]" >&2
      exit 0
      ;;
    *)
      echo "unknown arg: $arg" >&2
      exit 1
      ;;
  esac
done

need() {
  command -v "$1" >/dev/null || {
    echo "error: $1 not on PATH (enter repo shell: nix develop)" >&2
    exit 1
  }
}
need docker
need sops
need python3

compose() {
  docker compose -f "$STACK/compose.yaml" --project-directory "$STACK" "$@"
}

bao_exec() {
  local -a env_args=(-e BAO_ADDR=http://127.0.0.1:8200)
  if [[ -n ${BAO_TOKEN:-} ]]; then
    env_args+=(-e "BAO_TOKEN=$BAO_TOKEN")
  fi
  compose exec -T "${env_args[@]}" openbao bao "$@"
}

wait_api() {
  local _n rc
  for _n in $(seq 1 60); do
    # Exit 0 unsealed, 2 sealed/uninit — both mean the listener is up.
    rc=0
    compose exec -T -e BAO_ADDR=http://127.0.0.1:8200 openbao bao status >/dev/null 2>&1 || rc=$?
    if [[ $rc -eq 0 || $rc -eq 2 ]]; then
      return 0
    fi
    sleep 1
  done
  echo "error: OpenBao API not up — run ./scripts/deploy-containers openbao first" >&2
  exit 1
}

# Print status JSON (empty string on hard failure).
status_json() {
  bao_exec status -format=json 2>/dev/null || true
}

load_bootstrap_from_sops() {
  if [[ ! -f $ENC ]]; then
    return 1
  fi
  UNSEAL_KEY="$(sops -d "$ENC" | sed -n 's/^UNSEAL_KEY=//p' | head -1)"
  ROOT_TOKEN="$(sops -d "$ENC" | sed -n 's/^ROOT_TOKEN=//p' | head -1)"
  [[ -n ${UNSEAL_KEY:-} && -n ${ROOT_TOKEN:-} ]]
}

write_sops_bootstrap() {
  local key=$1 token=$2
  umask 077
  # Write plaintext at the final path so .sops.yaml creation_rules match, then encrypt in place.
  cat >"$ENC" <<EOF
# OpenBao bootstrap only (unseal + root). App secrets: secret/stacks/* in Bao.
# Edit: sops secrets/openbao.env
UNSEAL_KEY=$key
ROOT_TOKEN=$token
EOF
  sops -e -i --input-type dotenv --output-type dotenv "$ENC"
  chmod 600 "$ENC" 2>/dev/null || true
  echo "wrote encrypted bootstrap → $ENC"
}

# Import non-empty KEY=VAL from a sops env file into secret/stacks/<name>.
seed_stack_kv() {
  local name=$1
  local env_file=$2
  local plain
  if [[ ! -f $env_file ]]; then
    echo "seed: skip $name (missing $env_file)" >&2
    return 0
  fi
  plain="$(mktemp)"
  sops -d "$env_file" >"$plain"

  BAO_TOKEN="$ROOT_TOKEN" python3 - "$name" "$plain" "$STACK" <<'PY'
import os, subprocess, sys

name, plain_path, stack = sys.argv[1], sys.argv[2], sys.argv[3]
fields = []
with open(plain_path, encoding="utf-8") as f:
    for line in f:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, val = line.partition("=")
        key = key.strip()
        if not key or not val:
            continue
        fields.append(f"{key}={val}")

if not fields:
    fields = ["_placeholder=true"]

cmd = [
    "docker",
    "compose",
    "-f",
    f"{stack}/compose.yaml",
    "--project-directory",
    stack,
    "exec",
    "-T",
    "-e",
    "BAO_ADDR=http://127.0.0.1:8200",
    "-e",
    f"BAO_TOKEN={os.environ['BAO_TOKEN']}",
    "openbao",
    "bao",
    "kv",
    "put",
    f"secret/stacks/{name}",
    *fields,
]
subprocess.run(cmd, check=True)
print(f"seed: secret/stacks/{name} ({len(fields)} fields)")
PY
  rm -f "$plain"
}

# --- main ---

wait_api

st="$(status_json)"
if [[ -z $st ]]; then
  echo "error: could not read OpenBao status" >&2
  exit 1
fi

initialized=false
sealed=false
eval "$(printf '%s' "$st" | python3 -c "
import json,sys
d=json.load(sys.stdin)
print('initialized=' + ('true' if d.get('initialized') else 'false'))
print('sealed=' + ('true' if d.get('sealed') else 'false'))
")"

if [[ $initialized != true ]]; then
  echo "→ initializing OpenBao (1 unseal share / threshold 1)"
  init_json="$(bao_exec operator init -key-shares=1 -key-threshold=1 -format=json)"
  UNSEAL_KEY="$(echo "$init_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["unseal_keys_b64"][0])')"
  ROOT_TOKEN="$(echo "$init_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["root_token"])')"
  write_sops_bootstrap "$UNSEAL_KEY" "$ROOT_TOKEN"
  bao_exec operator unseal "$UNSEAL_KEY" >/dev/null
  echo "→ unsealed after init"
elif load_bootstrap_from_sops; then
  if [[ $sealed == true ]]; then
    bao_exec operator unseal "$UNSEAL_KEY" >/dev/null
    echo "→ unsealed with existing sops key"
  else
    echo "→ already initialized and unsealed"
  fi
else
  echo "error: OpenBao is initialized but $ENC is missing/incomplete." >&2
  echo "  Restore UNSEAL_KEY + ROOT_TOKEN into that sops file, then re-run." >&2
  exit 1
fi

export BAO_TOKEN="$ROOT_TOKEN"

# Enable kv-v2 at secret/ if needed
if BAO_TOKEN="$ROOT_TOKEN" bao_exec secrets list -format=json 2>/dev/null \
  | python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if any(k.rstrip("/")=="secret" for k in d) else 1)'; then
  echo "→ secret/ already enabled"
else
  echo "→ enabling kv-v2 at secret/"
  BAO_TOKEN="$ROOT_TOKEN" bao_exec secrets enable -path=secret kv-v2 >/dev/null
fi

for path in homepage grimmory papra; do
  if BAO_TOKEN="$ROOT_TOKEN" bao_exec kv get "secret/stacks/$path" >/dev/null 2>&1; then
    echo "→ secret/stacks/$path exists"
  else
    BAO_TOKEN="$ROOT_TOKEN" bao_exec kv put "secret/stacks/$path" \
      _managed_by=homelab \
      _note="fill via bootstrap --seed-from-sops or bao kv put" >/dev/null
    echo "→ created placeholder secret/stacks/$path"
  fi
done

if [[ $SEED -eq 1 ]]; then
  echo "→ seeding KV from sops app env (deploy-containers still deploys sops env files)"
  seed_stack_kv homepage "$SECRETS/homepage.env"
  seed_stack_kv grimmory "$SECRETS/grimmory.env"
  seed_stack_kv papra "$SECRETS/papra.env"
fi

echo
echo "Bootstrap OK."
echo "  Unseal/root: sops secrets/openbao.env"
echo "  KV plan:     secret/stacks/{homepage,grimmory,papra}"
echo "  App deploy:  still ./scripts/deploy-containers <stack> via secrets/*.env"
