#!/usr/bin/env bash
# Preflight for homelab: eval the lab system, optionally smoke the workstation
# shell and build the toplevel. No activation.
#   ./scripts/preflight          # local: eval + shell smoke + build (gate switch)
#   ./scripts/preflight --eval   # CI: eval + stacks YAML/Caddyfile
# Agents apply with nh os switch --target-host (skill homelab).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

eval_only=false
for arg in "$@"; do
  case "$arg" in
    --eval | --eval-only) eval_only=true ;;
    -h | --help)
      printf 'usage: %s [--eval]\n' "$(basename "$0")"
      exit 0
      ;;
    *)
      printf 'preflight: FAIL: unknown argument: %s\n' "$arg" >&2
      exit 1
      ;;
  esac
done

log() { printf 'preflight: %s\n' "$*"; }
fail() { printf 'preflight: FAIL: %s\n' "$*" >&2; exit 1; }

log "repo=$ROOT eval_only=$eval_only"

log "eval nixosConfigurations.homelab"
nix eval --raw '.#nixosConfigurations.homelab.config.system.build.toplevel.drvPath' >/dev/null

# Cheap, no Docker daemon. CI --eval must catch a broken compose.yaml
# or Caddyfile; Protect main only runs this script.
log "parse compose + homepage YAML; validate Caddyfile"
nix shell --inputs-from . nixpkgs#yq-go nixpkgs#caddy -c bash -euo pipefail -c '
  shopt -s nullglob
  files=(stacks/*/compose.yaml stacks/homepage/config/*.yaml)
  (( ${#files[@]} > 0 )) || { echo "preflight: FAIL: no YAML stacks" >&2; exit 1; }
  for f in "${files[@]}"; do
    yq -e "." "$f" >/dev/null
  done
  # PVE_UPSTREAM is required by the Caddyfile; dummy is syntax-only.
  export PVE_UPSTREAM="${PVE_UPSTREAM:-https://127.0.0.1:8006}"
  export BOOKLORE_PORT="${BOOKLORE_PORT:-6060}"
  if ! caddy_out=$(caddy validate --adapter caddyfile \
       --config stacks/caddy/Caddyfile 2>&1); then
    printf "%s\n" "$caddy_out" >&2
    exit 1
  fi
'

if $eval_only; then
  log "OK (eval lab toplevel + stacks YAML/Caddyfile; no build, no remote switch)"
  exit 0
fi

# Shell smoke when flake/lock or shell-related files look dirty is agent-side;
# always cheap enough here and catches lock-only breakage of workstation tools.
log "nix develop -c true (workstation shell smoke)"
nix develop -c true

log "build nixosConfigurations.homelab toplevel (no activate)"
built="$(nix build --no-link --print-out-paths \
  '.#nixosConfigurations.homelab.config.system.build.toplevel')"
log "built=$built"

log "OK (eval + shell smoke + system build; no remote switch)"
