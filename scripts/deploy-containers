#!/usr/bin/env bash
# Apply one (or all) Docker Compose stacks to the lab host from a workstation.
# NixOS system deploy is separate: nh os switch … --target-host …
#
# Secrets: sops-encrypted under secrets/<stack>.env (same age keys as sops-nix).
# This script decrypts to a gitignored path next to compose before `up`.
#
# Usage:
#   ./scripts/deploy-containers openbao
#   ./scripts/deploy-containers monitoring
#   ./scripts/deploy-containers homepage
#   ./scripts/deploy-containers --all
#   DOCKER_HOST=ssh://nico@homelab ./scripts/deploy-containers grimmory
#
# Requires: docker CLI with compose; sops + age key for stacks that use secrets.
# OpenBao: first init is scripts/openbao-bootstrap (not this script).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STACKS="$ROOT/stacks"
SECRETS="$ROOT/secrets"
export DOCKER_HOST="${DOCKER_HOST:-ssh://nico@homelab}"

# Map stack name → decrypted env file path relative to stack dir (compose env_file).
# Empty = no sops secret file for this stack.
# openbao: unseal/root stay in secrets/openbao.env and are applied by openbao-unseal
# (not compose env_file). App stacks keep sops env until Bao migration.
declare -A STACK_ENV_OUT=(
  [homepage]="secrets.env"
  [grimmory]=".env"
  [papra]=".env"
  [monitoring]=""
  [openbao]=""
)

# Stack dirs are those with compose.yaml (ignore README.md and other files).
list_stacks() {
  local d
  for d in "$STACKS"/*/; do
    [[ -f ${d}compose.yaml ]] || continue
    basename "$d"
  done | sort | tr '\n' ' '
}

usage() {
  echo "usage: $0 <stack>|--all [docker compose up args...]" >&2
  echo "stacks: $(list_stacks)" >&2
  exit 1
}

[[ $# -ge 1 ]] || usage

need_docker() {
  if ! command -v docker >/dev/null; then
    echo "error: docker not on PATH (enter the repo shell: nix develop)" >&2
    exit 1
  fi
  docker compose version >/dev/null
}

# Decrypt secrets/<stack>.env → stacks/<stack>/<out> (gitignored).
decrypt_stack_env() {
  local stack=$1
  local out_name=${STACK_ENV_OUT[$stack]-}
  local enc="$SECRETS/${stack}.env"
  local out_dir="$STACKS/$stack"
  local out_path

  if [[ -z $out_name ]]; then
    return 0
  fi
  out_path="$out_dir/$out_name"

  if [[ ! -f $enc ]]; then
    echo "error: missing encrypted secrets $enc (create with: sops $enc)" >&2
    exit 1
  fi
  if ! command -v sops >/dev/null; then
    echo "error: sops not on PATH (needed to decrypt $enc)" >&2
    exit 1
  fi

  umask 077
  sops -d "$enc" >"$out_path"
  chmod 600 "$out_path"
}

# Bind mounts are resolved on the *remote* daemon. Sync git-managed config there.
sync_remote_paths() {
  local stack=$1
  local host=${DOCKER_HOST#ssh://}
  case $stack in
    homepage)
      ssh -o BatchMode=yes "$host" "mkdir -p /home/nico/homepage/config"
      # Exclude runtime logs (container may own them; not in git).
      rsync -az --delete \
        --exclude logs/ \
        "$STACKS/homepage/config/" \
        "$host:/home/nico/homepage/config/"
      ;;
    openbao)
      # Dirs as the SSH user (nico). Compose runs as 1000:100 (NixOS users gid).
      ssh -o BatchMode=yes "$host" "mkdir -p /home/nico/openbao/config /home/nico/openbao/data"
      rsync -az --delete \
        "$STACKS/openbao/config/" \
        "$host:/home/nico/openbao/config/"
      ;;
  esac
}

up_one() {
  local stack=$1
  shift
  local dir="$STACKS/$stack"
  [[ -d $dir ]] || {
    echo "error: unknown stack '$stack'" >&2
    usage
  }
  [[ -f $dir/compose.yaml ]] || {
    echo "error: missing $dir/compose.yaml" >&2
    exit 1
  }

  decrypt_stack_env "$stack"
  sync_remote_paths "$stack"

  local -a env_args=()
  local out_name=${STACK_ENV_OUT[$stack]-}
  if [[ -n $out_name && -f $dir/$out_name ]]; then
    env_args+=(--env-file "$dir/$out_name")
  fi

  echo "→ $stack  (DOCKER_HOST=$DOCKER_HOST)"
  (
    cd "$dir"
    # compose.yaml may also list env_file: — file was just decrypted into place
    docker compose "${env_args[@]}" up -d "$@"
  )

  # OpenBao starts sealed; unseal from sops bootstrap when present (no-op if missing).
  if [[ $stack == openbao ]]; then
    "$ROOT/scripts/openbao-unseal" || {
      echo "warning: openbao-unseal failed (container is up; fix bootstrap or re-run)" >&2
    }
  fi
}

need_docker

target=$1
shift

if [[ $target == --all ]]; then
  # openbao first so a future consumer could depend on it; app stacks still sops.
  preferred=(openbao grimmory papra homepage monitoring)
  for s in "${preferred[@]}"; do
    [[ -f $STACKS/$s/compose.yaml ]] || continue
    up_one "$s" "$@"
  done
  for s in $(list_stacks); do
    skip=0
    for p in "${preferred[@]}"; do
      [[ $s == "$p" ]] && skip=1 && break
    done
    [[ $skip -eq 1 ]] && continue
    up_one "$s" "$@"
  done
else
  up_one "$target" "$@"
fi
