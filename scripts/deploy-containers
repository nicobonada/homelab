#!/usr/bin/env bash
# Apply one (or all) Docker Compose stacks to the lab host from a workstation.
# NixOS system deploy is separate: nixos-rebuild with --target-host …
#
# Secrets: 1Password Environment **Homelab** (local .env mount). This script
# materializes a filtered env file next to compose (gitignored) before `up`.
# Unlock 1Password desktop so the mount can be read.
#
# Usage:
#   ./scripts/deploy-containers monitoring
#   ./scripts/deploy-containers homepage
#   ./scripts/deploy-containers --all
#   DOCKER_HOST=ssh://nico@homelab ./scripts/deploy-containers grimmory
#
# Requires: docker CLI with compose; Homelab Environment mount present.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STACKS="$ROOT/stacks"
export DOCKER_HOST="${DOCKER_HOST:-ssh://nico@homelab}"

# 1Password Environments local mount (FIFO). Override if needed.
HOMELAB_ENV_MOUNT="${HOMELAB_ENV_MOUNT:-${XDG_CONFIG_HOME:-$HOME/.config}/grok/environments/Homelab.env}"

# Map stack name → env file path relative to stack dir (compose env_file).
# Empty = no env file for this stack.
declare -A STACK_ENV_OUT=(
  [homepage]="secrets.env"
  [grimmory]=".env"
  [papra]=".env"
  [monitoring]=".env"
)

# Keys to materialize per stack (from the shared Homelab Environment).
# Keep exact lists so APP_* from papra vs grimmory do not collide.
declare -A STACK_ENV_KEYS=(
  [homepage]="HOMEPAGE_ALLOWED_HOSTS HOMEPAGE_VAR_PVE_URL HOMEPAGE_VAR_DNS_URL HOMEPAGE_VAR_STATUS_URL HOMEPAGE_VAR_BOOKS_URL HOMEPAGE_VAR_DOCS_URL HOMEPAGE_VAR_DASHBOARD_URL HOMEPAGE_VAR_TECHNITIUM_HTTP HOMEPAGE_VAR_GATUS_HTTP HOMEPAGE_VAR_GRIMMORY_HTTP HOMEPAGE_VAR_PAPRA_HTTP HOMEPAGE_VAR_HOMEPAGE_HTTP HOMEPAGE_VAR_GLANCES_HTTP HOMEPAGE_VAR_PVE_TOKEN HOMEPAGE_VAR_PVE_SECRET HOMEPAGE_VAR_TECHNITIUM_KEY HOMEPAGE_VAR_TAILSCALE_KEY HOMEPAGE_VAR_TAILSCALE_DEVICE_ID"
  [grimmory]="APP_USER_ID APP_GROUP_ID TZ BOOKLORE_PORT DATABASE_URL DB_USER DB_PASSWORD DB_USER_ID DB_GROUP_ID MYSQL_ROOT_PASSWORD MYSQL_DATABASE"
  [papra]="AUTH_SECRET APP_BASE_URL CLIENT_BASE_URL"
  [monitoring]="GATUS_URL_HOMEPAGE GATUS_URL_GRIMMORY GATUS_URL_PAPRA GATUS_URL_GLANCES GATUS_URL_TECHNITIUM GATUS_URL_PROXMOX"
)

# Stack dirs are those with compose.yaml (ignore README.md and other files).
list_stacks() {
  local d
  for d in "$STACKS"/*/; do
    [[ -f ${d}compose.yaml ]] || continue
    basename "$d"
  done | sort | tr '\n' ' '
}

usage() {
  echo "usage: $0 <stack>|--all [docker compose up args...]" >&2
  echo "stacks: $(list_stacks)" >&2
  exit 1
}

[[ $# -ge 1 ]] || usage

need_docker() {
  if ! command -v docker >/dev/null; then
    echo "error: docker not on PATH (enter the repo shell: nix develop)" >&2
    exit 1
  fi
  docker compose version >/dev/null
}

# Read Homelab mount once → write stacks/<stack>/<out> with only that stack's keys.
materialize_stack_env() {
  local stack=$1
  local out_name=${STACK_ENV_OUT[$stack]-}
  local keys_str=${STACK_ENV_KEYS[$stack]-}
  local out_dir="$STACKS/$stack"
  local out_path
  local line key val
  local -A want=()
  local -A got=()
  local k missing=()

  if [[ -z $out_name ]]; then
    return 0
  fi
  out_path="$out_dir/$out_name"

  if [[ -z $keys_str ]]; then
    echo "error: no STACK_ENV_KEYS for stack '$stack'" >&2
    exit 1
  fi
  for k in $keys_str; do
    want["$k"]=1
  done

  if [[ ! -e $HOMELAB_ENV_MOUNT ]]; then
    echo "error: Homelab Environment mount not found: $HOMELAB_ENV_MOUNT" >&2
    echo "  Unlock 1Password and ensure Environment \"Homelab\" has a local .env mount." >&2
    exit 1
  fi

  # One open of the FIFO (1Password materializes once per open).
  local -a lines=()
  mapfile -t lines < <(timeout 30 cat -- "$HOMELAB_ENV_MOUNT" || true)
  if [[ ${#lines[@]} -eq 0 ]]; then
    echo "error: empty read from $HOMELAB_ENV_MOUNT (locked desktop? concurrent reader?)" >&2
    exit 1
  fi

  umask 077
  : >"$out_path"
  for line in "${lines[@]}"; do
    case "$line" in
      '' | \#*) continue ;;
    esac
    [[ $line == *=* ]] || continue
    key=${line%%=*}
    val=${line#*=}
    [[ -n ${want[$key]+x} ]] || continue
    # Preserve value as-is (including empty).
    printf '%s=%s\n' "$key" "$val" >>"$out_path"
    got["$key"]=1
  done
  chmod 600 "$out_path"

  for k in $keys_str; do
    [[ -n ${got[$k]+x} ]] || missing+=("$k")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "error: Homelab Environment missing keys for stack '$stack':" >&2
    printf '  %s\n' "${missing[@]}" >&2
    echo "  Add them in 1Password → Environments → Homelab" >&2
    exit 1
  fi
}

# Bind mounts are resolved on the *remote* daemon. Sync git-managed config there.
sync_remote_paths() {
  local stack=$1
  local host=${DOCKER_HOST#ssh://}
  case $stack in
    homepage)
      ssh -o BatchMode=yes "$host" "mkdir -p /home/nico/homepage/config"
      # Exclude runtime logs (container may own them; not in git).
      rsync -az --delete \
        --exclude logs/ \
        "$STACKS/homepage/config/" \
        "$host:/home/nico/homepage/config/"
      ;;
    monitoring)
      ssh -o BatchMode=yes "$host" "mkdir -p /home/nico/monitoring/config"
      rsync -az --delete \
        "$STACKS/monitoring/config/" \
        "$host:/home/nico/monitoring/config/"
      ;;
  esac
}

up_one() {
  local stack=$1
  shift
  local dir="$STACKS/$stack"
  [[ -d $dir ]] || {
    echo "error: unknown stack '$stack'" >&2
    usage
  }
  [[ -f $dir/compose.yaml ]] || {
    echo "error: missing $dir/compose.yaml" >&2
    exit 1
  }

  materialize_stack_env "$stack"
  sync_remote_paths "$stack"

  local -a env_args=()
  local out_name=${STACK_ENV_OUT[$stack]-}
  if [[ -n $out_name && -f $dir/$out_name ]]; then
    env_args+=(--env-file "$dir/$out_name")
  fi

  echo "→ $stack  (DOCKER_HOST=$DOCKER_HOST)"
  (
    cd "$dir"
    # compose.yaml may also list env_file: — file was just materialized
    docker compose "${env_args[@]}" up -d "$@"
  )
}

need_docker

target=$1
shift

if [[ $target == --all ]]; then
  preferred=(grimmory papra homepage monitoring)
  for s in "${preferred[@]}"; do
    [[ -f $STACKS/$s/compose.yaml ]] || continue
    up_one "$s" "$@"
  done
  for s in $(list_stacks); do
    skip=0
    for p in "${preferred[@]}"; do
      [[ $s == "$p" ]] && skip=1 && break
    done
    [[ $skip -eq 1 ]] && continue
    up_one "$s" "$@"
  done
else
  up_one "$target" "$@"
fi
