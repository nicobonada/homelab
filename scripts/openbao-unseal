#!/usr/bin/env bash
# Unseal OpenBao using the key in sops secrets/openbao.env.
# Safe when already unsealed. Exit 0 if bootstrap file is missing (not yet inited).
#
# Usage:
#   ./scripts/openbao-unseal
#   DOCKER_HOST=ssh://nico@homelab ./scripts/openbao-unseal
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STACK="$ROOT/stacks/openbao"
ENC="$ROOT/secrets/openbao.env"
export DOCKER_HOST="${DOCKER_HOST:-ssh://nico@homelab}"

if [[ ! -f $ENC ]]; then
  echo "openbao-unseal: no $ENC yet (run scripts/openbao-bootstrap after first up)" >&2
  exit 0
fi
if ! command -v sops >/dev/null; then
  echo "error: sops not on PATH" >&2
  exit 1
fi
if ! command -v docker >/dev/null; then
  echo "error: docker not on PATH (nix develop)" >&2
  exit 1
fi

UNSEAL_KEY="$(sops -d "$ENC" | sed -n 's/^UNSEAL_KEY=//p' | head -1)"
if [[ -z ${UNSEAL_KEY:-} ]]; then
  echo "error: UNSEAL_KEY empty in $ENC" >&2
  exit 1
fi

bao_exec() {
  docker compose -f "$STACK/compose.yaml" --project-directory "$STACK" exec -T \
    -e BAO_ADDR=http://127.0.0.1:8200 \
    openbao bao "$@"
}

# `bao status` exit 0 = unsealed, 2 = sealed/uninit (process up). Other = not ready.
api_up=0
for _ in $(seq 1 30); do
  rc=0
  docker compose -f "$STACK/compose.yaml" --project-directory "$STACK" exec -T \
    -e BAO_ADDR=http://127.0.0.1:8200 \
    openbao bao status >/dev/null 2>&1 || rc=$?
  if [[ $rc -eq 0 || $rc -eq 2 ]]; then
    api_up=1
    break
  fi
  sleep 1
done
if [[ $api_up -ne 1 ]]; then
  echo "error: OpenBao not reachable (is the stack up? ./scripts/deploy-containers openbao)" >&2
  exit 1
fi

# `bao status` exits non-zero when sealed; still emit JSON on stdout.
status_json="$(bao_exec status -format=json 2>/dev/null || true)"
if [[ -z $status_json ]]; then
  echo "error: could not read OpenBao status" >&2
  exit 1
fi

initialized=false
sealed=false
eval "$(printf '%s' "$status_json" | python3 -c "
import json,sys
d=json.load(sys.stdin)
print('initialized=' + ('true' if d.get('initialized') else 'false'))
print('sealed=' + ('true' if d.get('sealed') else 'false'))
")"

if [[ $initialized != true ]]; then
  echo "openbao-unseal: not initialized — run ./scripts/openbao-bootstrap" >&2
  exit 0
fi
if [[ $sealed != true ]]; then
  echo "openbao-unseal: already unsealed"
  exit 0
fi

bao_exec operator unseal "$UNSEAL_KEY" >/dev/null
echo "openbao-unseal: unsealed"
